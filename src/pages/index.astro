---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogPost from "../components/BlogPost.astro";

const pageTitle = "首页";
const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .sort((a: any, b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);

// 获取所有标签
const allTags = [...new Set(allPosts.flatMap((post: any) => post.data.tags || []))];
---

<BaseLayout pageTitle={pageTitle}>
  <section class="hero">
    <div class="hero-content">
      <div class="avatar">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </div>

      <h1>Newcode Wen</h1>
      <p class="hero-subtitle">数字花园 · 技术博客</p>

      <p class="hero-description">
        Hello, 大家好，我是 Newcode Wen，大家也可以叫我牛马文，或者牛码文。
        我希望自己写的代码很牛，在这里记录我的学习之旅和技术心得。
      </p>

      <div class="hero-actions">
        <a href="/blog/" class="btn btn-primary">浏览文章</a>
        <a href="/about/" class="btn btn-secondary">了解更多</a>
      </div>
    </div>
  </section>

  <section class="recent-posts">
    <div class="section-header">
      <h2 class="section-title">最新文章</h2>
      <a href="/blog/" class="view-all">
        查看全部
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <ul class="post-list">
      {
        recentPosts.map((post: any) => (
          <BlogPost
            title={post.data.title}
            url={`/posts/${post.id}`}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      }
    </ul>
  </section>

  {
    allTags.length > 0 && (
      <section class="tags-section">
        <h2 class="section-title">标签云</h2>
        <div class="tags tags-cloud">
          {allTags.map((tag: string) => (
            <a href={`/tags/${tag}`} class="tag tag-large">
              {tag}
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-12) var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-content {
    max-width: 60ch;
    margin: 0 auto;
  }

  .avatar {
    width: 100px;
    height: 100px;
    margin: 0 auto var(--space-6);
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: var(--shadow-lg);
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
    background: linear-gradient(135deg, var(--color-text), var(--color-primary-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-6);
    letter-spacing: 0.1em;
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: 1rem;
    font-weight: 500;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .btn-primary {
    background-color: var(--color-primary-600);
    color: white;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-700);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    color: white;
  }

  .btn-secondary {
    background-color: var(--color-gray-100);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background-color: var(--color-gray-200);
    color: var(--color-text);
  }

  html.dark .btn-secondary {
    background-color: var(--color-gray-800);
  }

  html.dark .btn-secondary:hover {
    background-color: var(--color-gray-700);
  }

  .recent-posts {
    margin-bottom: var(--space-12);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .view-all:hover {
    color: var(--color-accent);
    gap: var(--space-2);
  }

  .tags-section {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
  }

  .tags-cloud {
    gap: var(--space-3);
  }

  .tag-large {
    padding: var(--space-2) var(--space-4);
    font-size: 0.9375rem;
  }

  @media (max-width: 636px) {
    .hero {
      padding: var(--space-8) var(--space-4);
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }
  }
</style>
