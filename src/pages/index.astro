---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

import { FeedCard } from '@/components/blog/FeedCard'
import { SearchDialog } from '@/components/blog/SearchDialog'

// Get all blog posts
const allPosts = await getCollection('blog')
const publishedPosts = allPosts
  .map((post, index) => ({
    id: post.data.id || index + 1,
    slug: post.data.slug || post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category: post.data.category,
  }))
  .sort((a, b) => {
    const dateA = new Date(a.pubDate).getTime() || 0
    const dateB = new Date(b.pubDate).getTime() || 0
    return dateB - dateA
  })

// Page-specific SEO
const pageTitle = ''
const pageDescription = '个人博客，记录技术学习与日常生活'
const pageKeywords = '博客, 技术, 编程, Astro, React, Rust, Kotlin'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'newcode wen',
  description: pageDescription,
  url: 'http://localhost:4321/',
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <div class='mx-auto max-w-4xl px-6 pt-28 pb-16'>
    <!-- Hero -->
    <section class='mb-16'>
      <h1 class='font-serif text-4xl font-semibold tracking-tight text-foreground sm:text-5xl'>
        newcode wen
      </h1>
      <p class='mt-3 text-muted-foreground/70 text-base sm:text-lg max-w-lg leading-relaxed'>
        记录技术学习、编程心得与日常生活。
      </p>

      <!-- Search Trigger -->
      <button
        id='home-search-trigger'
        class='mt-8 flex w-full max-w-md items-center gap-3 rounded-xl border border-border bg-card px-4 py-3 text-left text-sm text-muted-foreground/50 shadow-sm transition-all hover:border-primary/30 hover:text-muted-foreground/70 hover:shadow-md'
      >
        <svg width="16" height="16" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class='shrink-0'>
          <path d="M10 6.5C10 8.433 8.433 10 6.5 10C4.567 10 3 8.433 3 6.5C3 4.567 4.567 3 6.5 3C8.433 3 10 4.567 10 6.5ZM9.30884 10.0159C8.53901 10.6318 7.56251 11 6.5 11C4.01472 11 2 8.98528 2 6.5C2 4.01472 4.01472 2 6.5 2C8.98528 2 11 4.01472 11 6.5C11 7.56251 10.6318 8.53901 10.0159 9.30884L12.8536 12.1464C13.0488 12.3417 13.0488 12.6583 12.8536 12.8536C12.6583 13.0488 12.3417 13.0488 12.1464 12.8536L9.30884 10.0159Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/>
        </svg>
        <span class='flex-1'>搜索文章...</span>
        <kbd class='hidden sm:inline-flex items-center gap-0.5 rounded-md border border-border bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground/50 font-mono'>
          <span>⌘</span>K
        </kbd>
      </button>
    </section>

    <!-- Blog Posts -->
    <section>
      <div class='mb-6 flex items-center gap-3'>
        <h2 class='font-serif text-xl font-semibold text-foreground'>文章</h2>
        <span class='text-muted-foreground/50 text-sm'>{publishedPosts.length} 篇</span>
      </div>

      <div>
        {
          publishedPosts.map((post) => (
            <FeedCard
              slug={post.slug}
              title={post.title}
              description={post.description}
              pubDate={post.pubDate}
              category={post.category}
            />
          ))
        }
      </div>
    </section>
  </div>

  <SearchDialog
    posts={publishedPosts.map((p) => ({
      slug: p.slug,
      title: p.title,
      description: p.description,
      category: p.category,
      pubDate: p.pubDate,
    }))}
    client:load
  />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.getElementById('home-search-trigger')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-search'))
    })
  })
</script>
