---
import { getCollection, render } from 'astro:content'
import { getCollection as getCollectionAll } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { SearchDialog } from '@/components/blog/SearchDialog'
import { calculateReadTime } from '@/utils/blog'

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog')
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry }
  }))
}

// Get all posts for search dialog
const allPosts = await getCollectionAll('blog')
const searchPosts = allPosts
  .map((post) => ({
    slug: post.data.slug || post.id,
    title: post.data.title,
    description: post.data.description,
    category: post.data.category,
    pubDate: post.data.pubDate,
  }))

const { entry } = Astro.props
const { Content } = await render(entry)

const readTime = entry.data.readTime || calculateReadTime(entry.body)

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  image: entry.data.imageUrl,
  datePublished: entry.data.pubDate,
  author: {
    '@type': 'Person',
    name: entry.data.author,
  },
}
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.imageUrl}
  type='article'
  publishedTime={entry.data.pubDate}
  author={entry.data.author}
  schema={schema}
>
  <article class='mx-auto max-w-3xl px-6 pt-28 pb-16'>
    <!-- Header -->
    <header class='mb-12'>
      <a
        href='/'
        class='text-muted-foreground/50 hover:text-foreground mb-8 inline-flex items-center gap-1.5 text-sm transition-colors'
      >
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6.85355 3.14645C7.04882 3.34171 7.04882 3.65829 6.85355 3.85355L3.70711 7H12.5C12.7761 7 13 7.22386 13 7.5C13 7.77614 12.7761 8 12.5 8H3.70711L6.85355 11.1464C7.04882 11.3417 7.04882 11.6583 6.85355 11.8536C6.65829 12.0488 6.34171 12.0488 6.14645 11.8536L2.14645 7.85355C1.95118 7.65829 1.95118 7.34171 2.14645 7.14645L6.14645 3.14645C6.34171 2.95118 6.65829 2.95118 6.85355 3.14645Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/>
        </svg>
        返回首页
      </a>

      <div class='flex items-center gap-2.5 text-sm text-muted-foreground/60'>
        <span>{entry.data.pubDate}</span>
        <span class='text-muted-foreground/30'>·</span>
        <span>{readTime} 分钟阅读</span>
        <span class='text-muted-foreground/30'>·</span>
        <span class='text-primary/70'>{entry.data.category}</span>
      </div>

      <h1 class='font-serif mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl'>
        {entry.data.title}
      </h1>

      <p class='mt-3 text-muted-foreground/70 text-base sm:text-lg leading-relaxed'>
        {entry.data.description}
      </p>
    </header>

    <!-- Hero Image -->
    {
      entry.data.imageUrl && (
        <div class='mb-12 overflow-hidden rounded-2xl'>
          <img
            src={entry.data.imageUrl}
            alt={entry.data.title}
            class='w-full object-cover'
            loading='eager'
          />
        </div>
      )
    }

    <!-- Content -->
    <div class='prose dark:prose-invert max-w-none'>
      <Content />
    </div>
  </article>

  <SearchDialog
    posts={searchPosts}
    client:load
  />
</Layout>
